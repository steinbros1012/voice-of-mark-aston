# Beep Me — Supabase Edge Function secrets (copy to supabase/functions/.env)
#
# Local:  supabase functions serve --env-file supabase/functions/.env
# Hosted: supabase secrets set --env-file supabase/functions/.env
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by the Supabase runtime and must not be set here.

# Stripe secret key (sk_test_ / sk_live_) and the webhook signing secret for
# the payments webhook function.
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# Resend: API key and the verified sender address.
RESEND_API_KEY=re_
RESEND_FROM_EMAIL="Beep Me <hello@yourdomain.com>"
# Inbox that receives new safety reports.
SUPPORT_EMAIL=support@yourdomain.com

# RevenueCat webhook authorization header value (Dashboard → Integrations → Webhooks).
REVENUECAT_WEBHOOK_SECRET=

# Public app origin, used in email links.
APP_URL=https://yourdomain.com
