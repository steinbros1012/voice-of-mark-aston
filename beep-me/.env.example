# Beep Me — client environment (copy to .env, never commit .env)
#
# Only variables prefixed EXPO_PUBLIC_ are inlined into the app bundle, and
# they are visible to anyone with the binary. Put ONLY publishable keys here.
# Server-side secrets (Stripe secret key, Resend, service role) live in
# supabase/functions/.env — see supabase/functions/.env.example.

# ── Supabase ───────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The anon (public) key. Newer projects label this the "publishable" key
# (sb_publishable_...); either value works here.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Stripe (Connect) ───────────────────────────────────────────────────────
# Dashboard → Developers → API keys. Use pk_test_ while developing.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
# Apple Pay merchant identifier (optional until you enable Apple Pay).
EXPO_PUBLIC_STRIPE_MERCHANT_ID=merchant.app.beepme.mobile

# ── RevenueCat ─────────────────────────────────────────────────────────────
# Dashboard → Project → API keys (public app-specific keys, one per store).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_

# ── PostHog ────────────────────────────────────────────────────────────────
# Project Settings → Project API key. Host is us.i.posthog.com or eu.i.posthog.com.
EXPO_PUBLIC_POSTHOG_KEY=phc_
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Sentry ─────────────────────────────────────────────────────────────────
# Project → Settings → Client Keys (DSN). Safe to ship in the client.
EXPO_PUBLIC_SENTRY_DSN=
# Build-time only (source-map upload). NOT shipped in the app.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── App ────────────────────────────────────────────────────────────────────
# Public web origin used for share links (https://<host>/beep/<id>) and
# universal links. Leave blank until you own a domain.
EXPO_PUBLIC_APP_URL=
# EAS project id (from `eas init`). Build-time only.
EAS_PROJECT_ID=
